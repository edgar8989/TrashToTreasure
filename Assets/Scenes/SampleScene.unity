  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd8b6702025418e4c80c2f7cf29594f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PakBudiDialogue
  prompt: '[E] Interaksi'
  startAutomatically: 1
  interactionDistance: 3
  characterName: Pak Budi
  openingDialogueLines:
  - 'Pak Budi: Selamat pagi. Saya ingin mengingatkan bahwa SPP anakmu belum dibayar.'
  - 'Pemain: Iya, Pak. Saya belum memiliki cukup uang untuk membayarnya.'
  - 'Pak Budi: Kamu bisa mendapatkan uang dengan mengumpulkan dan mendaur ulang sampah.'
  - 'Pak Budi: Temui Pak Iwan dan selesaikan dua tugas yang akan dia berikan.'
  - 'Pemain: Baik, Pak. Setelah menyelesaikan tugas tersebut, saya akan kembali untuk
    membayar SPP.'
  sppAmount: 250000
  prerequisiteLines:
  - 'Pak Budi: Sebelum membayar SPP, kamu harus menyelesaikan dua tugas dari Pak
    Iwan terlebih dahulu.'
  - 'Pak Budi: Selesaikan tugas mengumpulkan sampah dan membuat produk daur ulang.'
  - 'Pemain: Baik, Pak. Saya akan menyelesaikan kedua tugas itu terlebih dahulu.'
  insufficientMoneyLines:
  - 'Pak Budi: Uang yang kamu miliki masih belum cukup untuk membayar SPP.'
  - 'Pak Budi: Kamu membutuhkan Rp250.000. Terus kumpulkan uang sampai jumlahnya
    mencukupi.'
  - 'Pemain: Baik, Pak. Saya akan mengumpulkan kekurangannya.'
  paymentLines:
  - 'Pak Budi: Apakah kamu sudah siap membayar SPP sebesar Rp250.000?'
  - 'Pemain: Iya, Pak. Saya sudah menyelesaikan kedua tugas dan membawa uangnya.'
  - 'Pak Budi: Baik, saya terima pembayaran SPP ini. Terima kasih.'
  - 'Pemain: Sama-sama, Pak. Saya senang kewajiban ini sudah selesai.'
  alreadyPaidLines:
  - 'Pak Budi: Pembayaran SPP sudah kami terima. Terima kasih sudah menyelesaikannya.'
  - 'Pemain: Sama-sama, Pak.'
  destinationPoint: {fileID: 27767169}
  fadeDuration: 0.8
  blackScreenDuration: 0.5
